  "configure": [
    {
      "intent": "добавить description описание на интерфейс",
      "template": [
        "interface {iface}",
        "description {value}"
      ]
    },
    {
      "intent": "настроить ip адрес на интерфейсе",
      "template": [
        "interface {iface}",
        "ip address {ip} {mask}",
        "no shutdown"
      ]
    },
    {
      "intent": "no shutdown включить поднять интерфейс",
      "template": [
        "interface {iface}",
        "no shutdown"
      ]
    },
    {
      "intent": "shutdown выключить интерфейс",
      "template": [
        "interface {iface}",
        "shutdown"
      ]
    },
    {
      "intent": "добавить хост в acl access-list разрешить permit",
      "template": [
        "ip access-list extended {acl_name}",
        "permit ip host {host} any"
      ]
    },
    {
      "intent": "добавить сеть в acl access-list разрешить permit",
      "template": [
        "ip access-list extended {acl_name}",
        "permit ip {network} {wildcard} any"
      ]
    },
    {
      "intent": "добавить хост в acl access-list запретить deny",
      "template": [
        "ip access-list extended {acl_name}",
        "deny ip host {host} any"
      ]
    },
    {
      "intent": "добавить хост в vty acl access-class разрешить",
      "template": [
        "ip access-list standard VTY-ACCESS",
        "permit {host}",
        "line vty 0 4",
        "access-class VTY-ACCESS in"
      ]
    },
    {
      "intent": "удалить хост из acl access-list",
      "template": [
        "ip access-list extended {acl_name}",
        "no permit ip host {host} any"
      ]
    },
    {
      "intent": "добавить статический маршрут route",
      "template": [
        "ip route {network} {mask} {gateway}"
      ]
    },
    {
      "intent": "удалить статический маршрут route",
      "template": [
        "no ip route {network} {mask} {gateway}"
      ]
    },
    {
      "intent": "добавить vlan коммутатор",
      "template": [
        "vlan {vlan_id}",
        "name {vlan_name}"
      ]
    },
    {
      "intent": "назначить vlan на порт access",
      "template": [
        "interface {iface}",
        "switchport mode access",
        "switchport access vlan {vlan_id}"
      ]
    },
    {
      "intent": "настроить trunk порт vlan",
      "template": [
        "interface {iface}",
        "switchport mode trunk",
        "switchport trunk allowed vlan {vlan_id}"
      ]
    },
    {
      "intent": "добавить loopback интерфейс",
      "template": [
        "interface Loopback{id}",
        "ip address {ip} 255.255.255.255",
        "no shutdown"
      ]
    },
    {
      "intent": "настроить ospf добавить сеть",
      "template": [
        "router ospf 1",
        "network {network} {wildcard} area {area}"
      ]
    },
    {
      "intent": "настроить ntp сервер",
      "template": [
        "ntp server {host}"
      ]
    },
    {
      "intent": "добавить snmp community",
      "template": [
        "snmp-server community {community} RO"
      ]
    },
    {
      "intent": "настроить banner motd",
      "template": [
        "banner motd # {text} #"
      ]
    },
    {
      "intent": "сохранить конфигурацию write memory",
      "template": [
        "write memory"
      ]
    },
    {
      "intent": "добавить пользователя username",
      "template": [
        "username {username} privilege 15 secret {password}"
      ]
    },
    {
      "intent": "настроить dhcp пул pool",
      "template": [
        "ip dhcp pool {pool_name}",
        "network {network} {mask}",
        "default-router {gateway}",
        "dns-server {dns}"
      ]
    },
    {
      "intent": "исключить адреса dhcp excluded",
      "template": [
        "ip dhcp excluded-address {start} {end}"
      ]
    }
  ]
}